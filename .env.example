# Studio Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# LLM Providers (Optional - Smart Mock engine provides rich Tamil/Tanglish/English content without keys)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=auto

# ASR & Transcription (Whisper API / Groq / Local ffmpeg alignment)
ASR_PROVIDER=auto

# Search Provider (DuckDuckGo / Mock verified sources)
SEARCH_PROVIDER=duckduckgo

# File Storage
STORAGE_DIR=./storage
